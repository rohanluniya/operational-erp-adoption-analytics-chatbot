# CORE Pulse — Environment Configuration (copy to .env; never commit real secrets)

# Database backend: "mssql" (GKE SQL Server 2022 with native RLS) or "duckdb" (local file)
DB_BACKEND=duckdb
DUCKDB_PATH=data/core_pulse.duckdb

# SQL Server connection (used when DB_BACKEND=mssql)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=core_pulse
MSSQL_SA_USER=sa
MSSQL_SA_PASSWORD=
MSSQL_APP_USER=pulse_reader
MSSQL_APP_PASSWORD=
ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERT=yes

# Deterministic demo clock & seed
AS_OF_DATE=2026-11-17
DEMO_SEED=42

# Conversational LLM configuration (LiteLLM provider string; "rules" runs offline without an LLM)
LLM_MODEL=ollama/gpt-oss:20b
LLM_MODEL_CHOICES=ollama/gpt-oss:20b,ollama/qwen2.5-coder:14b
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_NUM_CTX=8192
GPT_OSS_REASONING_EFFORT=low
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOOL_CALLS_PER_TURN=3

# Optional cloud provider via LiteLLM (e.g. openai/gpt-4o-mini) if enabled later
OPENAI_API_KEY=

# Shared demo sign-in access code
APP_ACCESS_CODE=my-access-code
APP_HISTORY_DB=data/app_history.sqlite
